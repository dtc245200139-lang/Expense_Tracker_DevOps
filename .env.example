# -----------------------------------------------------------------------------
# CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU CHO EXPENSE TRACKER (GIÁ TRỊ AN TOÀN)
# Sao chép file này thành '.env' và chỉnh sửa trước khi chạy trong thực tế.
# -----------------------------------------------------------------------------

# Cổng truy cập ứng dụng Web trên máy host
PORT=3000

# Cấu hình kết nối cơ sở dữ liệu PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=expense_user
DB_PASSWORD=REPLACE_WITH_A_UNIQUE_DATABASE_PASSWORD
DB_NAME=expense_tracker_db

# Cấu hình tài khoản đăng nhập pgAdmin 4
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=REPLACE_WITH_A_UNIQUE_PGADMIN_PASSWORD
PGADMIN_PORT=5050

# Cấu hình tài khoản quản trị Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_GRAFANA_PASSWORD
# Secret dung de bao ve session dang nhap
SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32_OUTPUT
