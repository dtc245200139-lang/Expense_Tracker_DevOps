# -----------------------------------------------------------------------------
# CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU CHO EXPENSE TRACKER (GIÁ TRỊ AN TOÀN)
# Sao chép file này thành '.env' và chỉnh sửa trước khi chạy trong thực tế.
# -----------------------------------------------------------------------------

# Cổng truy cập ứng dụng Web trên máy host
PORT=3000

# Cấu hình kết nối cơ sở dữ liệu PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=expense_user
DB_PASSWORD=change_this_to_a_secure_db_password
DB_NAME=expense_tracker_db

# Cấu hình tài khoản đăng nhập pgAdmin 4
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_this_to_a_secure_pgadmin_password
PGADMIN_PORT=5050

# Cấu hình tài khoản quản trị Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_to_a_secure_grafana_password
