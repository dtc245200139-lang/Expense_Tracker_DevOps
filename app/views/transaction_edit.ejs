<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container mb-5" style="max-width: 650px;">
    <div class="card table-card bg-white p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold mb-0">Chỉnh Sửa Giao Dịch #<%= transaction.id %></h4>
            <a href="/transactions" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>

        <form action="/transactions/<%= transaction.id %>/update" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-3">
                <label class="form-label fw-semibold">Loại giao dịch</label>
                <div class="d-flex gap-4">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="type" id="editTypeExpense" value="expense" <%= transaction.type === 'expense' ? 'checked' : '' %>>
                        <label class="form-check-label text-danger fw-semibold" for="editTypeExpense">
                            <i class="bi bi-arrow-up-right me-1"></i> Chi tiêu
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="type" id="editTypeIncome" value="income" <%= transaction.type === 'income' ? 'checked' : '' %>>
                        <label class="form-check-label text-success fw-semibold" for="editTypeIncome">
                            <i class="bi bi-arrow-down-left me-1"></i> Thu nhập
                        </label>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Nội dung *</label>
                <input type="text" class="form-control" name="title" value="<%= transaction.title %>" required>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Số tiền (VNĐ) *</label>
                <input type="number" step="1000" min="1000" class="form-control" name="amount" value="<%= transaction.amount %>" required>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Danh mục</label>
                <select class="form-select" name="category_id">
                    <option value="">-- Chọn danh mục --</option>
                    <% categories.forEach(c => { %>
                        <option value="<%= c.id %>" <%= transaction.category_id === c.id ? 'selected' : '' %>>
                            <%= c.type === 'income' ? '[Thu] ' : '[Chi] ' %><%= c.name %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Ngày thực hiện</label>
                <% 
                    // Format transaction_date thành YYYY-MM-DD cho input type="date"
                    const dateObj = new Date(transaction.transaction_date);
                    const formattedDate = dateObj.toISOString().split('T')[0];
                %>
                <input type="date" class="form-control" name="transaction_date" value="<%= formattedDate %>" required>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Ghi chú</label>
                <textarea class="form-control" name="notes" rows="3"><%= transaction.notes || '' %></textarea>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a href="/transactions" class="btn btn-secondary">Hủy bỏ</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i> Cập nhật thay đổi
                </button>
            </div>
        </form>
    </div>
</div>

<%- include('partials/footer') %>
